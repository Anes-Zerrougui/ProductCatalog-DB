@model ProductDeleteViewModel
@{
    ViewData["Title"] = "Delete product";
}

<h1 class="h3 mb-3">Delete product</h1>

<div class="card" style="max-width: 640px;">
    <div class="card-body">
        <h2 class="h5">@Model.ProductName</h2>
        <p class="text-muted mb-3">SKU <code>@Model.Sku</code> · Group: @Model.GroupName</p>

        <p>Are you sure you want to delete this product?</p>
        <p class="small text-muted">
            It will disappear from the lists but is kept in the database (soft delete),
            so its history stays valid. Its SKU can be used again.
        </p>

        <form asp-action="Delete" asp-route-id="@Model.ProductId" method="post">
            <button type="submit" class="btn btn-danger">Yes, delete</button>
            <a asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
