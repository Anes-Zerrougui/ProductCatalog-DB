@model ProductFormViewModel

<div class="row">
    <div class="col-md-8 mb-3">
        <label asp-for="ProductName" class="form-label"></label>
        <input asp-for="ProductName" class="form-control" maxlength="200" autofocus />
        <span asp-validation-for="ProductName" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Sku" class="form-label"></label>
        <input asp-for="Sku" class="form-control" maxlength="50" />
        <span asp-validation-for="Sku" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="GroupId" class="form-label"></label>
        <select asp-for="GroupId" asp-items="Model.Groups" class="form-select">
            <option value="">-- Select a group --</option>
        </select>
        <span asp-validation-for="GroupId" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Model.Statuses" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        @if (Model.IsEdit)
        {
            <label class="form-label">Current stock</label>
            <input class="form-control" value="@Model.CurrentStock" disabled />
            <div class="form-text">
                Stock is changed with
                <a asp-action="AdjustStock" asp-route-id="@Model.ProductId">Adjust stock</a>
                so every change is logged.
            </div>
        }
        else
        {
            <label asp-for="StockQuantity" class="form-label"></label>
            <input asp-for="StockQuantity" type="number" min="0" step="1" class="form-control" />
            <span asp-validation-for="StockQuantity" class="text-danger"></span>
        }
    </div>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<hr class="my-4" />

<h2 class="h6">Images</h2>
<p class="text-muted small">
    Paste image addresses (http or https). Choose the main image with the round button. Empty rows are ignored.
    To add more, save first, then edit again: new empty rows appear.
</p>
@for (var i = 0; i < Model.Images.Count; i++)
{
    <div class="input-group mb-1">
        <div class="input-group-text">
            <input class="form-check-input mt-0" type="radio" name="PrimaryImageIndex" value="@i" checked="@(Model.PrimaryImageIndex == i)" title="Main image" />
        </div>
        <input asp-for="Images[i].ImageUrl" class="form-control" placeholder="https://..." />
    </div>
    <div class="mb-2"><span asp-validation-for="Images[i].ImageUrl" class="text-danger"></span></div>
}

<h2 class="h6 mt-4">Attributes</h2>
<p class="text-muted small">Specifications such as RAM = 16 GB. Both fields are needed; empty rows are ignored.</p>
@for (var i = 0; i < Model.Attributes.Count; i++)
{
    <div class="row g-2 mb-1">
        <div class="col-md-5">
            <input asp-for="Attributes[i].Name" class="form-control" placeholder="Name (for example RAM)" />
        </div>
        <div class="col-md-7">
            <input asp-for="Attributes[i].Value" class="form-control" placeholder="Value (for example 16 GB)" />
        </div>
    </div>
    <div class="mb-2">
        <span asp-validation-for="Attributes[i].Name" class="text-danger"></span>
        <span asp-validation-for="Attributes[i].Value" class="text-danger"></span>
    </div>
}

<h2 class="h6 mt-4">Tags</h2>
<div class="mb-4">
    <input asp-for="TagsText" class="form-control" placeholder="business, portable" />
    <div class="form-text">
        Separate tags with commas. New tags are created automatically.
        @if (Model.ExistingTags.Count > 0)
        {
            <span>Existing tags: @string.Join(", ", Model.ExistingTags)</span>
        }
    </div>
    <span asp-validation-for="TagsText" class="text-danger"></span>
</div>
