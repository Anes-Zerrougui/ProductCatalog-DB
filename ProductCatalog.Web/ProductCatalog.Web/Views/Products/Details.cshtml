@model ProductDetailsViewModel
@{
    ViewData["Title"] = Model.ProductName;
    var canEdit = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Editor);
    var badge = Model.Status switch
    {
        "Active" => "bg-success",
        "Inactive" => "bg-dark",
        _ => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.ProductName</h1>
        <span class="text-muted">SKU: <code>@Model.Sku</code></span>
        <span class="badge @badge ms-2">@Model.Status</span>
    </div>
    <div class="text-nowrap">
        <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
        @if (canEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-outline-primary">Edit</a>
            <a asp-action="AdjustStock" asp-route-id="@Model.ProductId" class="btn btn-outline-success">Adjust stock</a>
            <a asp-action="Delete" asp-route-id="@Model.ProductId" class="btn btn-outline-danger">Delete</a>
        }
    </div>
</div>

@if (Model.Images.Count > 0)
{
    var primary = Model.Images.FirstOrDefault(i => i.IsPrimary) ?? Model.Images[0];
    <div class="mb-4">
        <img src="@primary.Url" alt="@Model.ProductName" class="rounded border mb-2" style="max-height: 280px; max-width: 100%; object-fit: contain;" />
        @if (Model.Images.Count > 1)
        {
            <div class="d-flex flex-wrap gap-2">
                @foreach (var img in Model.Images)
                {
                    <img src="@img.Url" alt="" class="rounded border @(img == primary ? "border-primary border-2" : "")" style="height: 64px; width: 86px; object-fit: cover;" loading="lazy" />
                }
            </div>
        }
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Group</dt>
            <dd class="col-sm-9">@Model.GroupName</dd>

            <dt class="col-sm-3">Price</dt>
            <dd class="col-sm-9">@Model.Price.ToString("N2")</dd>

            <dt class="col-sm-3">Stock</dt>
            <dd class="col-sm-9">@Model.StockQuantity</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>

            <dt class="col-sm-3">Tags</dt>
            <dd class="col-sm-9">
                @if (Model.Tags.Count == 0)
                {
                    <span>—</span>
                }
                else
                {
                    foreach (var t in Model.Tags)
                    {
                        <a asp-action="Index" asp-route-tag="@t" class="badge bg-light text-dark border text-decoration-none">@t</a>
                    }
                }
            </dd>

            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-3">Last updated</dt>
            <dd class="col-sm-9">@Model.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>
    </div>
</div>

<h2 class="h5">Attributes</h2>
@if (Model.Attributes.Count == 0)
{
    <p class="text-muted">No attributes.</p>
}
else
{
    <div class="table-responsive mb-4" style="max-width: 640px;">
        <table class="table table-sm table-striped align-middle">
            <tbody>
                @foreach (var a in Model.Attributes)
                {
                    <tr>
                        <th class="w-50">@a.Name</th>
                        <td>@a.Value</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h5">Price and stock history</h2>
<p class="text-muted small">Written automatically by a database trigger every time the price or the stock changes.</p>

@if (Model.History.Count == 0)
{
    <div class="alert alert-info">No changes recorded yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>When</th>
                    <th>Changed by</th>
                    <th>Price</th>
                    <th>Stock</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model.History)
                {
                    <tr>
                        <td>@h.ChangedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(h.ChangedBy ?? "—")</td>
                        <td>
                            @if (h.OldPrice != h.NewPrice)
                            {
                                <span>@(h.OldPrice?.ToString("N2")) → @(h.NewPrice?.ToString("N2"))</span>
                            }
                            else
                            {
                                <span class="text-muted">no change</span>
                            }
                        </td>
                        <td>
                            @if (h.OldStock != h.NewStock)
                            {
                                <span>@(h.OldStock) → @(h.NewStock)</span>
                            }
                            else
                            {
                                <span class="text-muted">no change</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
