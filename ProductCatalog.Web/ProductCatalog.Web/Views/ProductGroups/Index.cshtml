@model ProductGroupIndexViewModel
@{
    ViewData["Title"] = "Product Groups";
    var isAdmin = User.IsInRole(AppRoles.Admin);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Product Groups</h1>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">+ New group</a>
    }
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-6">
        <input name="search" value="@Model.Search" class="form-control" placeholder="Search by name or description" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        }
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">No product groups found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th class="text-center">Products</th>
                    <th>Last updated</th>
                    @if (isAdmin)
                    {
                        <th class="text-end">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@item.GroupName</td>
                        <td>@item.Description</td>
                        <td class="text-center">
                            <a asp-controller="Products" asp-action="Index" asp-route-groupId="@item.GroupId" class="text-decoration-none" title="Show these products">
                                <span class="badge bg-secondary">@item.ProductCount</span>
                            </a>
                        </td>
                        <td>@item.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        @if (isAdmin)
                        {
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.GroupId" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.GroupId" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
